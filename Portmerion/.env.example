# Credentials for the John Lewis scrapers (john1.js, john2.js, john_fuji.js,
# john_benson.js, john_portmeirion.js).
#
# Copy this file to .env and fill in the values. .env must never be committed.
# When these run under the spider platform, the platform's own .env is passed
# through and this file is not needed.

# CompetitorMonitor SFTP — matched CSVs are read from here and results written back
SFTP_HOST=sftp.competitormonitor.com
SFTP_PORT=2222
SFTP_USERNAME=external_data
SFTP_PASSWORD=

# ProxyRack residential proxy
PROXY_USER=competitormonitor-country-in
PROXY_PASS=
PROXY_HOST=private.residential.proxyrack.net
PROXY_COUNT=200

# Sent as the x-api-key header on John Lewis requests
JOHNLEWIS_API_KEY=

# Queue server
PORT=5054
SERVER=http://127.0.0.1:5054

# Puppeteer worker
THREADS=4
DELAY_MS=400
HEADLESS=1
USE_PROXY=1
HIDE_CHROME=0
BLOCK_TYPES=
PP_TIMEOUT=25000
PROFILE=/tmp/everton-pp-profile-shared

# ProxyRack GB (required when USE_PROXY=1)
PROXY_USER=competitormonitor-country-GB
PROXY_PASS=
PROXY_HOST=private.residential.proxyrack.net
PROXY_COUNT=200

# Chrome binary (auto-detected on Linux if unset)
# CHROME=/usr/bin/google-chrome-stable

# Supervisor
STATUS_INTERVAL_MS=30000
COMPLETE_STABLE_POLLS=3
MIN_URLS_BEFORE_DONE=100
EXIT_ON_COMPLETE=1
LOG_TO_CONSOLE=1
LOG_DIR=./logs

# Set FORCE_RUN=1 to re-run after a previous successful upload
# FORCE_RUN=1

# Set SKIP_SFTP=1 to export locally only (no upload)
# SKIP_SFTP=1

# SFTP upload on completion
SFTP_HOST=sftp.competitormonitor.com
SFTP_PORT=2222
SFTP_USER=external_data
SFTP_PASS=
SFTP_REMOTE_DIR=Kitbag/Everton

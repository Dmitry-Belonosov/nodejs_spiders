{
  "name": "rsonline-scraper",
  "private": true,
  "description": "Node scraper for uk.rs-online.com (Puppeteer + ProxyRack, bueromarkt-style)",
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.7.0",
    "puppeteer-core": "^24.43.1"
  },
  "scripts": {
    "start": "node run.js",
    "seed-sample": "cp urls.sample.json urls.json && echo 'using 30 sample product URLs'",
    "seed-sitemap": "node scripts/fetch_sitemap_urls.js",
    "seed-sitemap-sample": "MAX_SITEMAPS=2 LIMIT=10000 node scripts/fetch_sitemap_urls.js",
    "start-server": "node server.js",
    "start-pp": "node puppeteer_worker.js",
    "start-pp-direct": "USE_PROXY=0 node puppeteer_worker.js",
    "start-pp-visible": "USE_PROXY=0 HEADLESS=0 node puppeteer_worker.js",
    "export-jsonl": "node export_jsonl.js",
    "export-csv": "node export_csv.js"
  }
}

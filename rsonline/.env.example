# Only needed to run this spider standalone. Under the management platform the
# platform's own .env is passed through and this file is not used.
#
# Copy to .env and fill in PROXY_PASS. Never commit .env.

# ProxyRack residential proxy. RS Online is behind Akamai, so a UK residential
# exit IP is what keeps the crawl from being served "Access Denied".
PROXY_USER=competitormonitor-country-uk
PROXY_PASS=
PROXY_HOST=private.residential.proxyrack.net
PROXY_COUNT=200

# Set to 0 to crawl without a proxy (expect blocks after a handful of pages).
USE_PROXY=1

# Chrome for Testing binary. The platform detects and injects this.
# CHROME=/usr/bin/google-chrome-stable

THREADS=10
DELAY_MS=400
HEADLESS=0
WINDOWS=2

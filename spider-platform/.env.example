# ---------------------------------------------------------------- platform
# Web UI bind address. Keep 127.0.0.1 locally; on the server put nginx in front.
HOST=127.0.0.1
PLATFORM_PORT=8080

# Password for the web UI. If empty, only localhost may connect.
ADMIN_PASSWORD=
# Any long random string; keeps sessions valid across restarts.
SESSION_SECRET=

# Set to 1 when running behind nginx/Caddy with TLS.
BEHIND_PROXY=0
COOKIE_SECURE=0

# Where spiders, logs, artifacts and the state files live.
DATA_DIR=./data

# Port range handed to spider queue servers (one port per concurrent run).
SPIDER_PORT_START=5100
SPIDER_PORT_END=5199

MAX_UPLOAD_MB=300
MAX_RUNS_KEPT=3000

# Disk retention: delete run logs and archived exports after this many days,
# while always keeping the newest runs of every spider.
RETENTION_DAYS=60
KEEP_RUNS_PER_SPIDER=20

# ------------------------------------------------- defaults for all spiders
# Everything below is inherited by every spider process and can be overridden
# per spider in the UI.

# Chrome for Testing — required on the dedicated Mac. Regular Google Chrome.app
# is never used. Install with:
#   npx @puppeteer/browsers install chrome@132.0.6834.83 --path ~/chrome-for-testing
# CHROME=  (auto-detected when unset)

# Browser layout injected into every spider (overridable per spider in the UI):
# HEADLESS=0 WINDOWS=2 THREADS=10 HIDE_CHROME=1

# ProxyRack residential proxy.
# Leave PROXY_USER empty: each spider picks its own country (uk/de/GB/in).
# Spiders now fail immediately with a clear message when PROXY_PASS is missing,
# so a crawl can never silently run unproxied.
PROXY_HOST=private.residential.proxyrack.net
PROXY_USER=
PROXY_PASS=
PROXY_COUNT=200

# Sent as x-api-key by the John Lewis scrapers (Portmerion).
JOHNLEWIS_API_KEY=

# ------------------------------------------------------------------- SFTP
# Where finished CSVs are delivered. The platform uploads them itself, so no
# spider needs SFTP code or credentials of its own.
#
# Each file is delivered as {spider_name}_{YYYY-MM-DD_HH-mm-ss}.csv, so runs
# never overwrite one another in the remote directory.
#
# Copy this file to .env and fill in SFTP_PASSWORD there. .env is gitignored
# and must never be committed.
SFTP_HOST=sftp.competitormonitor.com
SFTP_PORT=2222
SFTP_USERNAME=external_data
SFTP_PASSWORD=
SFTP_REMOTE_PATH=/external_data/Dmitry

# Key-based auth instead of a password (optional).
# SFTP_PRIVATE_KEY=/etc/spider-platform/sftp_key

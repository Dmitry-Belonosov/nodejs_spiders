# Only needed to run this spider standalone. Under the management platform the
# platform's own .env is passed through and this file is not used.
#
# Copy to .env. Never commit .env.
#
# Default is a US VPN (USE_PROXY=0). If the system exit is not US and PROXY_PASS
# is set, the worker switches to ProxyRack country-us. Set STRICT_US=0 only to
# probe parsers when a US exit is unavailable.
STRICT_US=1

PROXY_USER=competitormonitor-country-us
PROXY_PASS=
PROXY_HOST=private.residential.proxyrack.net
PROXY_COUNT=200
USE_PROXY=0

THREADS=1
WINDOWS=1
DELAY_MS=5000
HEADLESS=0
HIDE_CHROME=0

# Comma-separated merchant names / domains treated as the client, not competitors.
CLIENT_MERCHANT_ALIASES=Drip Depot,DripDepot,dripdepot.com

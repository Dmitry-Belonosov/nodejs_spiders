# Bind locally. The shell is a desktop UI, not a public service.
HOST=127.0.0.1
PORT=8090

# Parent folder that holds the parsers. Leave empty to use the folder above this one.
PARSERS_DIR=

# ProxyRack — used only when a card is set to "ProxyRack".
# Leave PROXY_USER empty so each parser keeps its own country (GB / uk / de).
PROXY_HOST=private.residential.proxyrack.net
PROXY_USER=
PROXY_PASS=
PROXY_COUNT=200

# Finished CSVs are uploaded here, same layout as spider-platform.
SFTP_HOST=sftp.competitormonitor.com
SFTP_PORT=2222
SFTP_USERNAME=external_data
SFTP_PASSWORD=
SFTP_REMOTE_PATH=/external_data/Dmitry

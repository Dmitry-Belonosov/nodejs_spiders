# Only needed to run this spider standalone. Under the management platform the
# platform's own .env is passed through and this file is not used.
#
# Copy to .env and fill in PROXY_PASS if you use ProxyRack. Never commit .env.

# Default is VPN / system network (USE_PROXY=0). Set USE_PROXY=1 for ProxyRack.
PROXY_USER=competitormonitor-country-uk
PROXY_PASS=
PROXY_HOST=private.residential.proxyrack.net
PROXY_COUNT=200
USE_PROXY=0

THREADS=10
WINDOWS=2
DELAY_MS=800
HEADLESS=0
HIDE_CHROME=1

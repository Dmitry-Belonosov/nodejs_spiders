{
  "name": "autodoc-scraper",
  "private": true,
  "description": "Very-style Node scraper for autodoc.co.uk (~3M products via PLP + ProxyRack)",
  "dependencies": {
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "https-proxy-agent": "^5.0.1",
    "puppeteer-core": "^24.43.1"
  },
  "scripts": {
    "start": "node run.js",
    "seed-sample": "cp urls.sample.json urls.json && echo 'using 30-product sample'",
    "seed-from-jsonl": "node scripts/seed_from_jsonl.js",
    "start-server": "node server.js",
    "start-worker": "node axios_worker.js",
    "export-jsonl": "node export_jsonl.js",
    "export-csv": "node export_csv.js",
    "start-pp": "THREADS=4 BLOCK_TYPES= DELAY_MS=400 node puppeteer_worker.js",
    "start-pp-fast": "THREADS=4 PAGE_CONCURRENCY=2 BLOCK_TYPES=image,font DELAY_MS=200 node puppeteer_worker.js"
  }
}
